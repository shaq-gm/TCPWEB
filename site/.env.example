# Add real values privately to site/.env for local development,
# and to the Vercel project environment variables for hosting.
BEEHIIV_API_KEY=replace_with_your_private_api_key
BEEHIIV_PUBLICATION_ID=pub_00000000-0000-0000-0000-000000000000
# Shared production rate limiting (Upstash Redis via Vercel Marketplace).
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_private_redis_token
# LOCAL PREVIEW ONLY: uncomment a mock state. No subscription will be created.
# TEST_SIGNUP_STATUS=confirmation_required
